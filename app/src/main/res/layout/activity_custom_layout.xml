<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:paddingHorizontal="15dp"
        android:background="@color/theme_def_color">


        <ImageView
            android:id="@+id/def_title_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/ic_white_back"
            android:layout_gravity="center_vertical"/>

        <TextView
            android:id="@+id/def_title_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Def title"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:layout_gravity="center"/>



    </FrameLayout>


    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:id="@+id/web_parent_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <ProgressBar
            android:id="@+id/progress_load_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"/>

    </FrameLayout>







</LinearLayout>